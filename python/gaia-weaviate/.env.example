# ==============================================================================
# Gaia Node + Weaviate Integration - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and update the values for your specific setup

# ==============================================================================
# GAIA NODE CONFIGURATION
# ==============================================================================

# Your Gaia node URL (with /v1 endpoint)
# Examples:
#   - Public node: https://0x299eae67ba6bbae8d61faad2d70115dc5a6855c8.gaia.domains/v1
#   - Local node: http://localhost:8080/v1
GAIA_BASE_URL=https://0x299eae67ba6bbae8d61faad2d70115dc5a6855c8.gaia.domains/v1

# API key for your Gaia node
# Note: Public Gaia nodes often accept any value for testing
GAIA_API_KEY=test-key

# Preferred model name (will fallback to first available if not found)
GAIA_MODEL_NAME=llama-3.2-3b-instruct

# ==============================================================================
# WEAVIATE CONFIGURATION  
# ==============================================================================

# Weaviate host (without http:// or port)
WEAVIATE_HOST=localhost

# Weaviate port
WEAVIATE_PORT=8080

# Weaviate API key (leave empty if not using authentication)
WEAVIATE_API_KEY=

# Enable Weaviate authentication (true/false)
WEAVIATE_USE_AUTH=false

# ==============================================================================
# COLLECTION AND VECTORIZER CONFIGURATION
# ==============================================================================

# Default collection name for your knowledge base
DEFAULT_COLLECTION_NAME=MyKnowledgeBase

# Vectorizer module to use
# Options: text2vec-transformers, text2vec-openai, text2vec-cohere, text2vec-huggingface
VECTORIZER_MODULE=text2vec-transformers

# ==============================================================================
# GENERATION PARAMETERS
# ==============================================================================

# Maximum tokens for LLM responses
MAX_TOKENS=300

# Temperature for response generation (0.0 to 1.0)
TEMPERATURE=0.7

# Number of documents to retrieve for RAG context
SEARCH_LIMIT=3

# ==============================================================================
# EXTERNAL API KEYS (Optional)
# ==============================================================================

# OpenAI API key (required if using text2vec-openai vectorizer)
OPENAI_API_KEY=your-openai-api-key-here

# Cohere API key (required if using text2vec-cohere vectorizer)
COHERE_API_KEY=your-cohere-api-key-here

# Hugging Face API key (optional, for some Hugging Face models)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# ==============================================================================
# DEBUG AND PERFORMANCE SETTINGS
# ==============================================================================

# Enable debug logging (true/false)
DEBUG=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Batch size for document insertion
BATCH_SIZE=100

# Connection timeout in seconds
CONNECTION_TIMEOUT=30

# Request timeout in seconds
REQUEST_TIMEOUT=60

# ==============================================================================
# ENVIRONMENT-SPECIFIC CONFIGURATIONS
# ==============================================================================

# Uncomment and modify these sections for different environments

# # DEVELOPMENT ENVIRONMENT
# GAIA_BASE_URL=http://localhost:8080/v1
# WEAVIATE_HOST=localhost
# WEAVIATE_PORT=8080
# DEBUG=true

# # STAGING ENVIRONMENT
# GAIA_BASE_URL=https://staging-gaia-node.yourdomain.com/v1
# WEAVIATE_HOST=staging-weaviate.yourdomain.com
# WEAVIATE_PORT=443
# WEAVIATE_USE_AUTH=true
# DEBUG=false

# # PRODUCTION ENVIRONMENT
# GAIA_BASE_URL=https://production-gaia-node.yourdomain.com/v1
# WEAVIATE_HOST=production-weaviate.yourdomain.com
# WEAVIATE_PORT=443
# WEAVIATE_USE_AUTH=true
# WEAVIATE_API_KEY=your-production-weaviate-key
# DEBUG=false
# LOG_LEVEL=WARNING

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
# 1. Never commit your actual .env file to version control
# 2. Use strong, unique API keys for production environments
# 3. Rotate API keys regularly
# 4. Use environment-specific configurations
# 5. Enable authentication for production Weaviate instances